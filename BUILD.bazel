# ── Convenience target: run all tests ─────────────────────────────────────────

test_suite(
    name = "all_tests",
    tests = [
        ":test_utility",
        ":test_data_step",
        ":test_allflow_builder",
        ":test_data_workspace",
        ":test_engine_flow",
