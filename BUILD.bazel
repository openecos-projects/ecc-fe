load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# ── Core library ──────────────────────────────────────────────────────────────

py_library(
    name = "fecompiler",
    data = glob([
        "fecompiler/adapters/**/*.f",
        "fecompiler/catalog/builtin/*.json",
    ]),
    srcs = glob(["fecompiler/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "fecompiler_bin",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    deps = [":fecompiler"],
)

alias(
    name = "cli",
    actual = ":fecompiler_bin",
)

# ── Example run: ysyx_00000000 CPU + SoC frontend flow ──────────────────────
#
#   bazel run //:run_ysyx_00000000_soc
#
# Equivalent to:
#   python3 -m fecompiler.cli.main \
#       --design ysyx_00000000_soc \
#       --top ecos_sim_top \
#       --cpu-top-module ysyx_00000000 \
#       --cpu-filelist examples/ysyx_00000000/filelist.cpu.f \
#       --soc-filelist fecompiler/thirdparty/SoC/filelist.soc.f \
#       --testbench fecompiler/thirdparty/SoC/driver/main.cpp \
#       --sim-cpp fecompiler/thirdparty/SoC/driver/dpi_mem.cpp \
#       --sim-cpp fecompiler/thirdparty/SoC/driver/difftest.cpp \
#       --sim-cflag=-Ifecompiler/thirdparty/SoC \
#       --sim-ldflag=-ldl \
#       --sim-program add \
#       --sim-compile-march rv32i_zicsr \
#       --sim-compile-mabi ilp32 \
#       --sim-compile-opt-level=-O2 \
#       --sim-arg=--max-cycles \
#       --sim-arg=50000000 \
#       --sim-arg=--diff \
#       --sim-arg=--ref \
#       --sim-arg=fecompiler/thirdparty/SoC/tools/riscv32-spike-so \
#       --sim-arg=--diff-image-offset \
#       --sim-arg=0x100 \
#       --sim-arg=--diff-reset-vector \
#       --sim-arg=0x80000000 \
#       --rerun

py_binary(
    name = "run_ysyx_00000000_soc",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "ysyx_00000000_soc",
        "--top", "ecos_sim_top",
        "--cpu-top-module", "ysyx_00000000",
        "--cpu-filelist", "examples/ysyx_00000000/filelist.cpu.f",
        "--soc-filelist", "fecompiler/thirdparty/SoC/filelist.soc.f",
        "--testbench", "fecompiler/thirdparty/SoC/driver/main.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/dpi_mem.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/difftest.cpp",
        "--sim-cflag=-Ifecompiler/thirdparty/SoC",
        "--sim-ldflag=-ldl",
        "--sim-program", "add",
        "--sim-compile-march", "rv32i_zicsr",
        "--sim-compile-mabi", "ilp32",
        "--sim-compile-opt-level=-O2",
        "--sim-arg=--max-cycles",
        "--sim-arg=50000000",
        "--sim-arg=--diff",
        "--sim-arg=--ref",
        "--sim-arg=fecompiler/thirdparty/SoC/tools/riscv32-spike-so",
        "--sim-arg=--diff-image-offset",
        "--sim-arg=0x100",
        "--sim-arg=--diff-reset-vector",
        "--sim-arg=0x80000000",
        "--rerun",
    ],
    deps = [":fecompiler"],
    data = glob([
        "examples/ysyx_00000000/**",
        "fecompiler/thirdparty/SoC/**",
    ]),
)

# ── Example run: re-run only sim on existing workspace (reuse compiled binary) ─
#
#   bazel run //:run_ysyx_00000000_soc_sim_only
#
# Requires workspace_projects/ysyx_00000000_soc to already exist.

py_binary(
    name = "run_ysyx_00000000_soc_sim_only",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "ysyx_00000000_soc",
        "--top", "ecos_sim_top",
        "--workspace", "workspace_projects/ysyx_00000000_soc",
        "--sim-only",
        "--sim-reuse-binary",
        "--sim-arg=--max-cycles",
        "--sim-arg=50000000",
        "--sim-arg=--diff",
        "--sim-arg=--ref",
        "--sim-arg=fecompiler/thirdparty/SoC/tools/riscv32-spike-so",
        "--sim-arg=--diff-image-offset",
        "--sim-arg=0x100",
        "--sim-arg=--diff-reset-vector",
        "--sim-arg=0x80000000",
    ],
    deps = [":fecompiler"],
    data = glob([
        "fecompiler/thirdparty/SoC/**",
    ]),
)

