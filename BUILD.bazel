load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# ── Core library ──────────────────────────────────────────────────────────────

py_library(
    name = "fecompiler",
    srcs = glob(["fecompiler/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "fecompiler_bin",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    deps = [":fecompiler"],
)

alias(
    name = "cli",
    actual = ":fecompiler_bin",
)

# ── Example run: adder design using docs/examples/filelist.f ──────────────────
#
#   bazel run //:run_adder
#
# Equivalent to:
#   python3 -m fecompiler.cli.main \
#       --design adder --top adder --filelist docs/examples/filelist.f

py_binary(
    name = "run_adder",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "adder",
        "--top",    "adder",
        "--filelist", "docs/examples/filelist.f",
    ],
    deps = [":fecompiler"],
    data = glob(["docs/examples/**"]),
)

