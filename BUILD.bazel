load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# ── Core library ──────────────────────────────────────────────────────────────

py_library(
    name = "fecompiler",
    data = glob([
        "fecompiler/adapters/**/*.f",
        "fecompiler/catalog/builtin/*.json",
    ]),
    srcs = glob(["fecompiler/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "fecompiler_bin",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    deps = [":fecompiler"],
)

alias(
    name = "cli",
    actual = ":fecompiler_bin",
)

# ── Example run: CL3 CPU + SoC full frontend flow ────────────────────────────
#
#   bazel run //:run_cl3_soc
#
# Equivalent to:
#   python3 -m fecompiler.cli.main \
#       --design cl3_soc_phase2_full \
#       --top ysyxSoCTop \
#       --cpu-filelist examples/cl3/filelist.cpu.f \
#       --soc-filelist fecompiler/thirdparty/SoC/filelist.soc.f \
#       --testbench fecompiler/thirdparty/SoC/driver/main.cpp \
#       --sim-cpp fecompiler/thirdparty/SoC/driver/dpi_mem.cpp \
#       --sim-cflag=-Ifecompiler/thirdparty/SoC \
#       --sim-image fecompiler/thirdparty/SoC/tests/out/min2.soc.bin \
#       --sim-arg=--max-cycles \
#       --sim-arg=2000000 \
#       --rerun

py_binary(
    name = "run_cl3_soc",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "cl3_soc_phase2_full",
        "--top", "ysyxSoCTop",
        "--cpu-filelist", "examples/cl3/filelist.cpu.f",
        "--soc-filelist", "fecompiler/thirdparty/SoC/filelist.soc.f",
        "--testbench", "fecompiler/thirdparty/SoC/driver/main.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/dpi_mem.cpp",
        "--sim-cflag=-Ifecompiler/thirdparty/SoC",
        "--sim-image", "fecompiler/thirdparty/SoC/tests/out/min2.soc.bin",
        "--sim-arg=--max-cycles",
        "--sim-arg=2000000",
        "--rerun",
    ],
    deps = [":fecompiler"],
    data = glob([
        "examples/cl3/**",
        "fecompiler/thirdparty/SoC/**",
    ]),
)

# ── Example run: CL3 CPU + SoC full flow with all prebuilt *.soc.bin tests ───
#
#   bazel run //:run_cl3_soc_all_tests

py_binary(
    name = "run_cl3_soc_all_tests",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "cl3_soc_phase2_full",
        "--top", "ysyxSoCTop",
        "--cpu-filelist", "examples/cl3/filelist.cpu.f",
        "--soc-filelist", "fecompiler/thirdparty/SoC/filelist.soc.f",
        "--testbench", "fecompiler/thirdparty/SoC/driver/main.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/dpi_mem.cpp",
        "--sim-cflag=-Ifecompiler/thirdparty/SoC",
        "--sim-all-tests",
        "--sim-arg=--max-cycles",
        "--sim-arg=2000000",
        "--rerun",
    ],
    deps = [":fecompiler"],
    data = glob([
        "examples/cl3/**",
        "fecompiler/thirdparty/SoC/**",
    ]),
)

# ── Example run: re-run only sim on existing workspace (reuse compiled binary) ─
#
#   bazel run //:run_cl3_soc_sim_only_all_tests
#
# Requires workspace_projects/cl3_soc_phase2_full to already exist.

py_binary(
    name = "run_cl3_soc_sim_only_all_tests",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "cl3_soc_phase2_full",
        "--top", "ysyxSoCTop",
        "--workspace", "workspace_projects/cl3_soc_phase2_full",
        "--sim-only",
        "--sim-reuse-binary",
        "--sim-all-tests",
        "--sim-arg=--max-cycles",
        "--sim-arg=2000000",
    ],
    deps = [":fecompiler"],
    data = glob([
        "fecompiler/thirdparty/SoC/**",
    ]),
)

# ── Example run: CL3 CPU + SoC boots RT-Thread with default difftest ─────────
#
#   bazel run //:run_cl3_soc_rtthread
#
# Requires scons, a RISC-V GCC toolchain, and AM_HOME (or the default
# /home/luyoung/ysyx-workbench/abstract-machine) to be available.

py_binary(
    name = "run_cl3_soc_rtthread",
    srcs = ["fecompiler/cli/main.py"],
    main = "fecompiler/cli/main.py",
    args = [
        "--design", "cl3_soc_rtthread",
        "--top", "ysyxSoCTop",
        "--workspace", "/home/luyoung/ecc-fe/workspace_projects/cl3_soc_rtthread",
        "--cpu-filelist", "examples/cl3/filelist.cpu.f",
        "--soc-filelist", "fecompiler/thirdparty/SoC/filelist.soc.f",
        "--testbench", "fecompiler/thirdparty/SoC/driver/main.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/dpi_mem.cpp",
        "--sim-cpp", "fecompiler/thirdparty/SoC/driver/difftest.cpp",
        "--sim-cflag=-Ifecompiler/thirdparty/SoC",
        "--sim-ldflag=-ldl",
        "--sim-program", "rtthread",
        "--sim-programs-dir", "fecompiler/thirdparty/SoC/tests/programs",
        "--sim-arg=--max-cycles",
        "--sim-arg=10000000",
        "--sim-arg=--wave",
        "--sim-arg=/dev/null",
        "--rerun",
    ],
    deps = [":fecompiler"],
    data = glob([
        "examples/cl3/**",
        "fecompiler/thirdparty/SoC/**",
        "fecompiler/thirdparty/rt-thread-am/**",
    ]),
)

