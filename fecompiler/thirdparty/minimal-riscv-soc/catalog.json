{
  "id": "minimal-riscv-soc",
  "name": "ECOS Minimal CPU Test Harness",
  "description": "Local ECOS Verilog test harness for lightweight RISC-V CPU tests. It provides DPI memory, UART, and trap MMIO; it is not a full SoC.",
  "variant": "minimal-riscv",
  "isa": [
    "rv32"
  ],
  "bus": "axi-lite-memory",
  "integration_level": "sim_ready",
  "status": "experimental",
  "wrapper_contract": "ecos-sim-wrapper-v1",
  "wrapper_top": "ecos_sim_top",
  "cpu_socket_contract": "ysyx-axi-cpu-socket-v1",
  "supports_difftest": false,
  "supported_test_suites": [
    "smoke",
    "cpu-tests"
  ],
  "directory": "fecompiler/thirdparty/minimal-riscv-soc",
  "tags": [
    "test-harness",
    "minimal",
    "cpu-tests",
    "local"
  ]
}
