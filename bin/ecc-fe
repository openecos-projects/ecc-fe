#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ECC_FE_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="${ECC_FE_ROOT}:${PYTHONPATH}"
else
  export PYTHONPATH="${ECC_FE_ROOT}"
fi

export ECOS_FE_COMPILER_ROOT="${ECOS_FE_COMPILER_ROOT:-${ECC_FE_ROOT}}"

PYTHON_BIN="${ECOS_FE_PYTHON:-${PYTHON_INTERPRETER:-python3}}"
exec "${PYTHON_BIN}" -m fecompiler.cli.main "$@"
